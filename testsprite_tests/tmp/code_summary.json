{
  "project_name": "HeavenMatch Contact Page",
  "project_type": "frontend",
  "tech_stack": {
    "frontend": {
      "framework": "React",
      "version": "18.2.0",
      "routing": "React Router DOM 6.30.1",
      "styling": "CSS3 with custom components",
      "icons": "Font Awesome",
      "build_tool": "Create React App"
    },
    "backend": {
      "runtime": "Node.js",
      "framework": "Express.js",
      "version": "4.21.2",
      "middleware": ["CORS", "dotenv"],
      "port": 3001
    },
    "ai_integration": {
      "provider": "OpenRouter",
      "model": "meta-llama/llama-3.1-8b-instruct",
      "api_type": "RESTful",
      "real_time": true
    }
  },
  "main_features": [
    {
      "name": "AI Chat Widget",
      "description": "Real-time conversational AI with context-aware responses",
      "location": "src/components/LiveChatWidget.js"
    },
    {
      "name": "Intent Detection",
      "description": "Automatically classifies user queries into 6 categories: billing, technical, safety, account, profile_match, general",
      "location": "src/components/LiveChatWidget.js, server.js/api/detect-intent"
    },
    {
      "name": "Information Extraction",
      "description": "Extracts name, email, phone, and subject from conversation and auto-fills contact form",
      "location": "src/components/LiveChatWidget.js, server.js/api/extract-info"
    },
    {
      "name": "FAQ Search",
      "description": "8 pre-built FAQs with AI enhancement for instant answers",
      "location": "src/components/LiveChatWidget.js, server.js/api/faq-search"
    },
    {
      "name": "Smart Routing",
      "description": "Routes users to best support channel: email, phone, ticket, or chat",
      "location": "src/components/LiveChatWidget.js, server.js/api/smart-route"
    },
    {
      "name": "Ticket Creation",
      "description": "Auto-creates support tickets with generated IDs (HM-XXXXXXXX)",
      "location": "src/components/LiveChatWidget.js, server.js/api/create-ticket"
    },
    {
      "name": "Sentiment Analysis",
      "description": "Detects 18 emotions and adjusts responses accordingly",
      "location": "src/components/LiveChatWidget.js, server.js/api/analyze-sentiment"
    },
    {
      "name": "Language Detection",
      "description": "Detects user language and provides multi-language support",
      "location": "src/components/LiveChatWidget.js, server.js/api/detect-language"
    },
    {
      "name": "Quick Replies",
      "description": "Generates 3 AI-suggested quick reply options",
      "location": "src/components/LiveChatWidget.js, server.js/api/quick-replies"
    },
    {
      "name": "Conversation Summary",
      "description": "Auto-generates summaries for agent handoff",
      "location": "src/components/LiveChatWidget.js, server.js/api/summarize-conversation"
    },
    {
      "name": "Smart Escalation",
      "description": "Automatically escalates complex issues to human agents",
      "location": "src/components/LiveChatWidget.js, server.js/api/should-escalate"
    },
    {
      "name": "Priority Detection",
      "description": "Detects urgency level: low, medium, high",
      "location": "src/components/LiveChatWidget.js, server.js"
    },
    {
      "name": "Profile Suggestions",
      "description": "Suggests profiles with male/female selection for matchmaking",
      "location": "src/components/LiveChatWidget.js"
    },
    {
      "name": "Contact Form",
      "description": "Contact form with file upload and auto-fill from chat",
      "location": "src/components/ContactForm.js"
    },
    {
      "name": "Navigation",
      "description": "Main navigation with Contact, Support, Locations, Help pages",
      "location": "src/components/Navigation.js"
    }
  ],
  "pages": [
    {
      "name": "HomePage",
      "route": "/",
      "location": "src/pages/HomePage.js"
    },
    {
      "name": "ContactPage",
      "route": "/contact",
      "location": "src/pages/ContactPage.js",
      "features": ["Contact form", "Live chat widget", "Contact information"]
    },
    {
      "name": "SupportPage",
      "route": "/support",
      "location": "src/pages/SupportPage.js"
    },
    {
      "name": "LocationsPage",
      "route": "/locations",
      "location": "src/pages/LocationsPage.js"
    },
    {
      "name": "HelpPage",
      "route": "/help",
      "location": "src/pages/HelpPage.js"
    }
  ],
  "api_endpoints": [
    {
      "path": "/api/health",
      "method": "GET",
      "description": "Health check endpoint"
    },
    {
      "path": "/api/chat",
      "method": "POST",
      "description": "Main AI chat endpoint"
    },
    {
      "path": "/api/detect-intent",
      "method": "POST",
      "description": "Detect user intent from message"
    },
    {
      "path": "/api/extract-info",
      "method": "POST",
      "description": "Extract user information from conversation"
    },
    {
      "path": "/api/smart-route",
      "method": "POST",
      "description": "Get smart routing suggestion"
    },
    {
      "path": "/api/faq-search",
      "method": "POST",
      "description": "Search FAQ database"
    },
    {
      "path": "/api/create-ticket",
      "method": "POST",
      "description": "Create support ticket"
    },
    {
      "path": "/api/analyze-sentiment",
      "method": "POST",
      "description": "Analyze sentiment and emotion"
    },
    {
      "path": "/api/detect-language",
      "method": "POST",
      "description": "Detect message language"
    },
    {
      "path": "/api/quick-replies",
      "method": "POST",
      "description": "Generate quick reply suggestions"
    },
    {
      "path": "/api/summarize-conversation",
      "method": "POST",
      "description": "Summarize conversation"
    },
    {
      "path": "/api/should-escalate",
      "method": "POST",
      "description": "Check if issue should be escalated"
    }
  ],
  "key_components": [
    "LiveChatWidget",
    "ContactForm",
    "ContactPage",
    "Navigation",
    "Footer",
    "TicketSystem"
  ],
  "port": 3000,
  "backend_port": 3001
}

